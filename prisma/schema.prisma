datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Существующая модель Bike с добавлением обратной связи для сессий
model Bike {
  id            Int             @id @default(autoincrement())
  speed         String          // Строковый стандарт из техпаспорта v3.3
  range         String          // Строковый стандарт из техпаспорта v3.3
  motor         String          // Строковый стандарт из техпаспорта v3.3
  isWaterproof  Boolean         // Булевый стандарт из техпаспорта v3.3
  status        String          // Статусы: "AVAILABLE", "RENTED", "MAINTENANCE"
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Связь: Один байк может фигурировать в разных сессиях аренды (история + текущая)
  rentalSessions RentalSession[]
}

// Новая модель Курьера (User)
model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  password  String   @default("") // Временно добавили дефолт для прохождения миграции
  name      String   @default("Курьер") // Временно добавили дефолт для существующих строк
  balance   Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalSessions RentalSession[]
}


// Новая модель Сессии Аренды (RentalSession)
model RentalSession {
  id        Int       @id @default(autoincrement())
  tariff    String    // Тариф курьера (например: "DAILY", "WEEKLY")
  status    String    // Статус сессии (например: "ACTIVE", "COMPLETED")
  startDate DateTime  @default(now()) // Дата старта аренды
  endDate   DateTime? // Дата завершения (null, пока аренда активна)
  
  // Внешние ключи для связи One-to-Many
  userId    Int
  bikeId    Int

  // Отношения (Relations) с каскадным удалением
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bike      Bike      @relation(fields: [bikeId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Индексы для оптимизации частых выборок в ЛК курьера со смартфона
  @@index([userId])
  @@index([bikeId])
}
